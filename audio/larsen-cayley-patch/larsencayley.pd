#X text 1400 45 SPIN (rotor rate);
#X obj 1400 70 vsl 24 140 0 127 0 0 empty empty empty 0 -9 0 10 -262144 -1 -1 0 0;
#X obj 1400 220 expr $f1/127.*1.9+0.02;
