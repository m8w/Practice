#N canvas 40 40 1400 800 12;
#X text 20 20 LARSEN // CAYLEY -- generative feedback + octonion cross-mod noise engine (Pd vanilla port);
#X text 20 45 toggle ENGINE to start the modulation clocks\; PANIC zeroes Larsen feedback instantly.;
#X text 20 75 ENGINE;
#X obj 20 95 tgl 24 0 empty empty empty 0 -8 0 10 -262144 -1 -1 0 1;
#X text 20 135 PANIC (kill feedback);
#X obj 20 155 bng 24 250 50 0 empty empty empty 0 -8 0 10 -262144 -1 -1;
#X msg 20 190 0;
#X obj 20 225 metro 180;
#X text 20 255 clockA: voice pitch wander;
#X obj 20 285 metro 2600;
#X text 20 315 clockB: Larsen delay/filter wander;
#X obj 20 345 metro 6200;
#X text 20 375 clockC: macro (drive/reverb) wander;
#X text 20 410 STARTUP DEFAULTS (loadbang -> sane initial levels);
#X obj 20 440 loadbang;
#X msg 20 470 0.55;
#X msg 20 498 8.;
#X msg 20 526 0.35;
#X msg 20 554 0.65;
#X msg 20 582 0.3;
#X msg 20 610 0.7;
#X msg 20 638 1.1;
#X msg 20 666 0.4;
#X msg 20 694 0.5;
#X text 280 20 CAYLEY VOICE 0 (base 55 Hz);
#X obj 280 50 random 13;
#X obj 280 80 - 6;
#X obj 280 110 + 0;
#X obj 280 140 clip 0 47;
#X obj 280 170 t f f;
#X obj 280 210 expr 55.0*pow(2\,($f1-24)/12);
#X obj 280 245 pack 0. 300;
#X obj 280 280 line~;
#X obj 280 315 osc~ 55;
#X text 560 20 CAYLEY VOICE 1 (base 110 Hz);
#X obj 560 50 random 13;
#X obj 560 80 - 6;
#X obj 560 110 + 0;
#X obj 560 140 clip 0 47;
#X obj 560 170 t f f;
#X obj 560 210 expr 110.0*pow(2\,($f1-24)/12);
#X obj 560 245 pack 0. 300;
#X obj 560 280 line~;
#X obj 560 315 osc~ 110;
#X text 840 20 CAYLEY VOICE 2 (base 220 Hz);
